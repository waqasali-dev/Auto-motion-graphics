# FRAME/60 — Dual-Route & Concurrency Configuration
# Copy this file to .env and fill in your private API keys.
# (Do NOT commit your real .env file with live credentials)

# Active Route: route1 (AgentRouter) or route2 (Custom OpenAI Route / HCNSEC)
VITE_ACTIVE_ROUTE=route2

# How many concurrent AI agents should generate Remotion TSX code simultaneously (Stage 4)
VITE_CODE_CONCURRENCY=2

# ==============================================================================
# ROUTE 1: AgentRouter
# ==============================================================================
VITE_OPENAI_API_KEY=your_agentrouter_key_here
VITE_OPENAI_BASE_URL=https://agentrouter.org/v1
VITE_OPENAI_MODEL=gpt-6-astra
VITE_OPENAI_PLANNER_MODEL=gpt-6-astra

# ==============================================================================
# ROUTE 2: Custom OpenAI Route (e.g. HCNSEC / GLM-5.3)
# ==============================================================================
NEW_API_KEY=your_custom_api_key_here
NEW_API_MODEL=glm-5.3
NEW_API_BASE_URL=https://api.hcnsec.cn/v1
NEW_API_MAX_TOKENS=32768

VITE_NEW_API_KEY=your_custom_api_key_here
VITE_NEW_API_MODEL=glm-5.3
VITE_NEW_API_BASE_URL=https://api.hcnsec.cn/v1
VITE_NEW_API_MAX_TOKENS=32768
